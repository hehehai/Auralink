<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements of auralink-helper inside Auralink.app
     (mygo.json macos.helperEntitlements). Under the hardened runtime
     (Developer ID builds) the helper records from the microphone and sends
     Apple Events to browsers (browser.url, automation.*). Ad hoc builds run
     without the hardened runtime and do not check them. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
