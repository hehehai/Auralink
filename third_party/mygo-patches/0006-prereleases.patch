+// TestWriteDeltasPrereleases makes delta updates from the newest release
+// and the newest prerelease on GitHub, so that both channels get one.
+func TestWriteDeltasPrereleases(t *testing.T) {
+	pub, priv, _ := ed25519.GenerateKey(nil)
+	t.Setenv("MYGO_UPDATER_PRIVATE_KEY", base64.StdEncoding.EncodeToString(priv))
+	t.Setenv("GH_TOKEN", "")
+	t.Setenv("GITHUB_TOKEN", "")
+	code := make([]byte, 50_000)
+	for i := range code {
+		code[i] = byte(i * i >> 3)
+	}
+	app := func(dir, version string) []string {
+		os.MkdirAll(dir, 0o755)
+		os.WriteFile(filepath.Join(dir, "app"), append(slices.Clone(code), version...), 0o755)
+		return []string{"app"}
+	}
+	const target = "linux-amd64"
+	// files are what github.com serves by path; releases what the API
+	// lists, newest first; latest the tag of the latest release.
+	files := map[string][]byte{}
+	var releases []map[string]any
+	latest := ""
+	var apiRequests int
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.Host == "api.github.com" && r.URL.Path == "/repos/me/app/releases":
+			apiRequests++
+			if r.URL.Query().Get("page") != "1" {
+				w.Write([]byte("[]"))
+				return
+			}
+			json.NewEncoder(w).Encode(releases)
+		case r.Host == "github.com":
+			p := r.URL.Path
+			if rest, ok := strings.CutPrefix(p, "/me/app/releases/latest/download/"); ok {
+				if latest == "" {
+					http.NotFound(w, r)
+					return
+				}
+				p = "/me/app/releases/download/" + latest + "/" + rest
+			}
+			if b, ok := files[p]; ok {
+				w.Write(b)
+				return
+			}
+			http.NotFound(w, r)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer srv.Close()
+	saved := http.DefaultTransport
+	t.Cleanup(func() { http.DefaultTransport = saved })
+	base := saved.(*http.Transport).Clone()
+	http.DefaultTransport = roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		r = r.Clone(r.Context())
+		r.Host = r.URL.Host
+		r.URL.Scheme, r.URL.Host = "http", strings.TrimPrefix(srv.URL, "http://")
+		return base.RoundTrip(r)
+	})
+
+	// publish builds version as a release of GitHub would have it: its
+	// archive, deltas and manifest under its tag, and lists it.
+	build := func(version string, prereleases bool) update.Manifest {
+		t.Helper()
+		stage := t.TempDir()
+		entries := app(stage, version)
+		c := &Config{root: t.TempDir(), Name: "App", Version: version, Updates: &Updates{PublicKey: base64.StdEncoding.EncodeToString(pub), GitHub: "me/app", TagPrefix: "v", Prereleases: prereleases}}
+		written, err := writeArchive(c, stage, target, entries)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var m update.Manifest
+		data, _ := os.ReadFile(written[len(written)-1])
+		if err := json.Unmarshal(data, &m); err != nil {
+			t.Fatal(err)
+		}
+		for _, f := range written {
+			b, _ := os.ReadFile(f)
+			files["/me/app/releases/download/v"+version+"/"+filepath.Base(f)] = b
+		}
+		return m
+	}
+	publish := func(version string) {
+		pre := strings.Contains(version, "-")
+		releases = append([]map[string]any{{"tag_name": "v" + version, "prerelease": pre}}, releases...)
+		if !pre {
+			latest = "v" + version
+		}
+	}
+	froms := func(m update.Manifest) []string {
+		var from []string
+		for _, d := range m.Deltas {
+			from = append(from, d.From)
+		}
+		return from
+	}
+
+	// The first versions are betas: no latest release yet.
+	if m := build("0.1.0-beta.1", true); m.Deltas != nil {
+		t.Errorf("the first version has deltas from %v", froms(m))
+	}
+	publish("0.1.0-beta.1")
+	m := build("0.1.0-beta.2", true)
+	if got := froms(m); !slices.Equal(got, []string{"0.1.0-beta.1"}) {
+		t.Errorf("0.1.0-beta.2: deltas from %v, want 0.1.0-beta.1", got)
+	}
+	publish("0.1.0-beta.2")
+	if got := froms(build("0.1.0", true)); !slices.Equal(got, []string{"0.1.0-beta.2", "0.1.0-beta.1"}) {
+		t.Errorf("0.1.0: deltas from %v", got)
+	}
+	publish("0.1.0")
+	// A beta of the next version updates the release and the last beta.
+	if got := froms(build("0.2.0-beta.1", true)); !slices.Equal(got, []string{"0.1.0", "0.1.0-beta.2", "0.1.0-beta.1"}) {
+		t.Errorf("0.2.0-beta.1: deltas from %v", got)
+	}
+	publish("0.2.0-beta.1")
+	// Each channel's newest version comes first, whatever the count.
+	m = build("0.2.0", true)
+	if got := froms(m); len(got) != 3 || got[0] != "0.2.0-beta.1" || got[1] != "0.1.0" {
+		t.Errorf("0.2.0: deltas from %v", got)
+	}
+	d := 1
+	c := &Config{root: t.TempDir(), Name: "App", Version: "0.2.0", Updates: &Updates{PublicKey: base64.StdEncoding.EncodeToString(pub), GitHub: "me/app", TagPrefix: "v", Prereleases: true, Deltas: &d}}
+	stage := t.TempDir()
+	written, err := writeArchive(c, stage, target, app(stage, "0.2.0"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var one update.Manifest
+	data, _ := os.ReadFile(written[len(written)-1])
+	json.Unmarshal(data, &one)
+	if got := froms(one); !slices.Equal(got, []string{"0.2.0-beta.1"}) {
+		t.Errorf("one delta: from %v", got)
+	}
+
+	// Without prereleases, only the latest release's chain, and no API.
+	apiRequests = 0
+	if got := froms(build("0.2.0", false)); !slices.Equal(got, []string{"0.1.0", "0.1.0-beta.2", "0.1.0-beta.1"}) || apiRequests != 0 {
+		t.Errorf("without prereleases: deltas from %v, %d API requests", got, apiRequests)
+	}
