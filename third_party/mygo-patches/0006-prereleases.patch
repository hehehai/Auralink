+		{"1.2.1", false, "up to date"},
+	} {
+		if got := check(c.current, c.pre); got != c.want {
+			t.Errorf("from %s, prereleases %t: %s, want %s", c.current, c.pre, got, c.want)
+		}
+	}
+	// A release newer than every prerelease is the update of both.
+	releases = append([]string{"v1.3.0"}, releases...)
+	latest = "v1.3.0"
+	if got := check("1.3.0-beta.2", true); got != "1.3.0" {
+		t.Errorf("from the last beta: %s, want 1.3.0", got)
+	}
+	if got := check("1.3.0-beta.2", false); got != "1.3.0" {
+		t.Errorf("from the last beta, prereleases off: %s, want 1.3.0", got)
+	}
+
+	// Without the API, prereleases fall back to the latest release, and
+	// say why when it is no update.
+	limited, apiRequests = true, 0
+	if got := check("1.2.0", true); got != "1.3.0" || apiRequests != 1 {
+		t.Errorf("rate limited: %s after %d API requests, want 1.3.0", got, apiRequests)
+	}
+	if got := check("1.3.0", true); !strings.Contains(got, "GitHub takes no more requests") {
+		t.Errorf("rate limited and up to date: %s", got)
+	}
+	if got := check("1.2.0", false); got != "1.3.0" || apiRequests != 2 {
+		t.Errorf("without prereleases the API is not asked: %s after %d API requests", got, apiRequests)
+	}
+	limited = false
+
+	// Only prereleases yet: there is nothing to install without them.
+	releases, latest = []string{"v0.1.0-beta.2", "v0.1.0-beta.1"}, ""
+	if got := check("0.1.0-beta.1", true); got != "0.1.0-beta.2" {
+		t.Errorf("first betas: %s", got)
+	}
+	_, err := checkUpdate(ctx, feed, key, "0.1.0-beta.1", false)
+	if !errors.Is(err, ErrNotPublished) {
+		t.Errorf("no release yet: %v, want ErrNotPublished", err)
+	}
+	releases = nil
+	if _, err := checkUpdate(ctx, feed, key, "0.1.0-beta.1", true); !errors.Is(err, ErrNotPublished) {
+		t.Errorf("no release at all: %v, want ErrNotPublished", err)
+	}
+
+	// Feeds of other servers have no prereleases.
+	srv, key2, _, _ := updateServer(t, "1.2.0", "v2", "")
+	if up, err := checkUpdate(ctx, srv.URL+"/update.json", key2, "1.1.9", true); err != nil || up == nil || up.Version != "1.2.0" {
+		t.Errorf("a feed of another server with prereleases: %+v, %v", up, err)
+	}
+
+	Updater.SetPrereleases(true)
+	if !Updater.Prereleases() {
+		t.Error("SetPrereleases(true) did not stick")
+	}
+	Updater.SetPrereleases(false)
+}
